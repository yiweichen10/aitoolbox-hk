{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ],
  "redirects": [
    { "source": "/tools/hedra/", "destination": "/category/", "statusCode": 301 },
    { "source": "/tools/hedra", "destination": "/category/", "statusCode": 301 },
    { "source": "/tools/hedra/index.html", "destination": "/category/", "statusCode": 301 }
  ]
}
