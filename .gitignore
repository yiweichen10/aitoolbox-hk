# Environment variables — never commit secrets
.env
.env.*
!.env.example

# DataForSEO keyword data — local only, never commit
data/_kw/

# Python cache
__pycache__/
*.py[cod]
*.pyo

# Temp data scripts — never commit
data/_*.py
# Generated analysis snapshots (regenerable from source data)
data/_pricing_index_snapshot.json
data/_pricing_index_history.json
# Backup files — never commit
*.bak
# news 合并备份的历史命名（.bak-<date>，曾误入库；现统一为覆盖式 news_en.json.bak）
data/news_en.json.bak-*

# Content exports — generated, never commit
exports/

# WorkBuddy local state — never commit
.workbuddy/

# OS
.DS_Store
Thumbs.db

# ===== 内部工作记忆/自动化日志（与网站无关，禁止入库公开）=====
.workbuddy-ai/

# Cloudflare Pages 部署产物（本地生成，禁止入库）
_deploy_cf/
_deploy_cf.zip
.wrangler/
.playwright-cli/

# Automation temp files (tool JSON staging, leaked by 16.Daily Tool Generator)
_tmp_*
_ff_check.html
gf_check.html
_genspark_check.html
